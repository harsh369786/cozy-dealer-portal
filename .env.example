# Optional CDN base for static assets (no trailing slash).
# Leave unset to serve from the local public/ folder at runtime.
# VITE_ASSET_BASE_URL=https://cdn.example.com

# Worker environment and optional comma-separated cross-origin frontends.
ENVIRONMENT=development
ALLOWED_ORIGINS=http://localhost:3000

# Set production secrets with `wrangler secret put NAME` (never commit values).
# Required before go-live: CRON_SECRET
# Required for PWA web push (in-app notifications work without these):
#   VAPID_PUBLIC_KEY, VAPID_PRIVATE_KEY, VAPID_SUBJECT
# JWT_SECRET=
# CRON_SECRET=
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=mailto:ops@example.com
