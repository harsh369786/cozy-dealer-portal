# Optional CDN base for static assets (no trailing slash).
# Leave unset to serve from the local public/ folder at runtime.
# VITE_ASSET_BASE_URL=https://cdn.example.com

# Worker environment and optional comma-separated cross-origin frontends.
ENVIRONMENT=development
ALLOWED_ORIGINS=http://localhost:3000

# Set production secrets with `wrangler secret put NAME` (never commit values).
# Required before go-live: CRON_SECRET
# Required for PWA web push (in-app notifications work without these):
#   VAPID_PUBLIC_KEY, VAPID_PRIVATE_KEY, VAPID_SUBJECT
# JWT_SECRET=
# CRON_SECRET=
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=mailto:ops@example.com

# --- Gupshup WhatsApp Business API ---
# API key is a SECRET — set via `wrangler secret put GUPSHUP_API_KEY` (never commit the value).
# When GUPSHUP_API_KEY is unset, WhatsApp sending is skipped and all business operations still work.
# GUPSHUP_API_KEY=
# Non-secret config (safe in wrangler.toml [vars] or here as placeholders):
# GUPSHUP_API_BASE_URL=https://api.gupshup.io
# GUPSHUP_SOURCE=918451945853            # WhatsApp business number, digits only (no +)
# GUPSHUP_SRC_NAME=Backrest              # Gupshup app name
# GUPSHUP_TEMPLATE_LANG=en
# Approved Gupshup template UUIDs (from the Gupshup console):
# GUPSHUP_TEMPLATE_ID_OTP=
# GUPSHUP_TEMPLATE_ID_ORDER_PLACED=
# GUPSHUP_TEMPLATE_ID_ORDER_REJECTED=
# GUPSHUP_TEMPLATE_ID_ORDER_DELIVERED=
# GUPSHUP_TEMPLATE_ID_CAMPAIGN_LIVE=
# Optional: designated test recipient (digits only) for the internal template test endpoint.
# WHATSAPP_TEST_PHONE=919821650772
